data/graph_view.html
graph_component.html

# Screenshots (local reference only)
screenshot_*.png

# Pyright local config
pyrightconfig.json

# Local captures (personal notes; regenerate with capture.py)
raw/*
!raw/.gitkeep

# Wiki — Obsidian workspace metadata (local only, not needed on cloud)
wiki/.obsidian/

# Wiki — binary attachments and media (keep .md notes; ignore everything else)
wiki/**/*.png
wiki/**/*.jpg
wiki/**/*.jpeg
wiki/**/*.gif
wiki/**/*.webp
wiki/**/*.svg
wiki/**/*.pdf
wiki/**/*.mp3
wiki/**/*.mp4
